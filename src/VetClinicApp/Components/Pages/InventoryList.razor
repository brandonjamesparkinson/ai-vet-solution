@page "/inventory"
@using VetClinicApp.Models
@using VetClinicApp.Services
@inject IVetService VetService
@rendermode InteractiveServer

<PageTitle>Inventory Management</PageTitle>

<div class="container-fluid pt-2 pb-4">
    <div class="row mb-2">
        <div class="col">
            <h4 class="mb-0 text-primary"><i class="bi bi-box-seam"></i> Inventory Management</h4>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary btn-sm" @onclick="AddNewItem"><i class="bi bi-plus"></i> Add Item</button>
        </div>
    </div>

    @if (InventoryItems == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body py-2 px-3">
                @if (SelectedItem != null)
                {
                    <div class="row g-2 align-items-center">
                        <div class="col-md-1 text-end"><label class="col-form-label-sm fw-bold mb-0">Code:</label></div>
                        <div class="col-md-2"><input type="text" class="form-control form-control-sm" @bind="SelectedItem.ItemCode" /></div>
                        
                        <div class="col-md-1 text-end"><label class="col-form-label-sm fw-bold mb-0">Name:</label></div>
                        <div class="col-md-3"><input type="text" class="form-control form-control-sm" @bind="SelectedItem.Name" /></div>
                        
                        <div class="col-md-1 text-end"><label class="col-form-label-sm fw-bold mb-0">Category:</label></div>
                        <div class="col-md-2">
                            <select class="form-select form-select-sm" @bind="SelectedItem.Category">
                                <option value="Vaccine">Vaccine</option>
                                <option value="Medication">Medication</option>
                                <option value="Food">Food</option>
                                <option value="Service">Service</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mt-1 align-items-center">
                        <div class="col-md-1 text-end"><label class="col-form-label-sm fw-bold mb-0">Desc:</label></div>
                        <div class="col-md-5"><input type="text" class="form-control form-control-sm" @bind="SelectedItem.Description" /></div>

                        <div class="col-md-1 text-end"><label class="col-form-label-sm fw-bold mb-0">Cost:</label></div>
                        <div class="col-md-1"><input type="number" step="0.01" class="form-control form-control-sm" @bind="SelectedItem.CostPrice" /></div>

                        <div class="col-md-1 text-end"><label class="col-form-label-sm fw-bold mb-0">Price:</label></div>
                        <div class="col-md-1"><input type="number" step="0.01" class="form-control form-control-sm" @bind="SelectedItem.SellingPrice" /></div>
                        
                        <div class="col-md-1 text-end"><label class="col-form-label-sm fw-bold mb-0">Qty:</label></div>
                        <div class="col-md-1"><input type="number" class="form-control form-control-sm" @bind="SelectedItem.QuantityOnHand" /></div>
                    </div>
                    <div class="row mt-2">
                        <div class="col text-end">
                            <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                            <button class="btn btn-success btn-sm" @onclick="SaveItem">Save Item</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted small">Select an item below to edit, or click Add Item.</div>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th class="text-end">Cost</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Qty</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in InventoryItems)
                    {
                        <tr>
                            <td class="fw-bold">@item.ItemCode</td>
                            <td>@item.Name</td>
                            <td><span class="badge bg-secondary">@item.Category</span></td>
                            <td>@item.Description</td>
                            <td class="text-end">@item.CostPrice.ToString("C")</td>
                            <td class="text-end">@item.SellingPrice.ToString("C")</td>
                            <td class="text-end @(item.QuantityOnHand < 5 ? "text-danger fw-bold" : "")">@item.QuantityOnHand</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary py-0" @onclick="() => EditItem(item)">Edit</button>
                            </td>
                        </tr>
                    }
                    @if (!InventoryItems.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-3">No inventory items found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<InventoryItem> InventoryItems;
    private InventoryItem SelectedItem;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        
        // Seed initial data if empty
        if (InventoryItems != null && !InventoryItems.Any())
        {
            await VetService.AddInventoryItemAsync(new InventoryItem { ItemCode = "EXAM-ANN", Name = "Annual Wellness Exam", Category = "Service", SellingPrice = 65.00m, CostPrice = 0, QuantityOnHand = 999 });
            await VetService.AddInventoryItemAsync(new InventoryItem { ItemCode = "RABIES-1Y", Name = "Rabies Vaccine (1 Year)", Category = "Vaccine", SellingPrice = 25.00m, CostPrice = 5.00m, QuantityOnHand = 50 });
            await VetService.AddInventoryItemAsync(new InventoryItem { ItemCode = "HEARTGARD-L", Name = "Heartgard Plus (51-100 lbs)", Category = "Medication", SellingPrice = 45.00m, CostPrice = 20.00m, QuantityOnHand = 24 });
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        InventoryItems = await VetService.GetInventoryItemsAsync();
    }

    private void AddNewItem()
    {
        SelectedItem = new InventoryItem { Category = "Vaccine" };
    }

    private void EditItem(InventoryItem item)
    {
        // Shallow copy so changes don't apply until saved
        SelectedItem = new InventoryItem
        {
            InventoryItemId = item.InventoryItemId,
            ItemCode = item.ItemCode,
            Name = item.Name,
            Description = item.Description,
            Category = item.Category,
            CostPrice = item.CostPrice,
            SellingPrice = item.SellingPrice,
            QuantityOnHand = item.QuantityOnHand
        };
    }

    private void CancelEdit()
    {
        SelectedItem = null;
    }

    private async Task SaveItem()
    {
        if (SelectedItem != null)
        {
            if (SelectedItem.InventoryItemId == 0)
            {
                await VetService.AddInventoryItemAsync(SelectedItem);
            }
            else
            {
                var existing = await VetService.GetInventoryItemByIdAsync(SelectedItem.InventoryItemId);
                if (existing != null)
                {
                    existing.ItemCode = SelectedItem.ItemCode;
                    existing.Name = SelectedItem.Name;
                    existing.Description = SelectedItem.Description;
                    existing.Category = SelectedItem.Category;
                    existing.CostPrice = SelectedItem.CostPrice;
                    existing.SellingPrice = SelectedItem.SellingPrice;
                    existing.QuantityOnHand = SelectedItem.QuantityOnHand;
                    await VetService.UpdateInventoryItemAsync(existing);
                }
            }
            SelectedItem = null;
            await LoadData();
        }
    }
}
